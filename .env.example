# --- CyberYukti .env.example — copy to .env and adjust ----------------------
# Never commit real .env files. Demo defaults below are safe for local use.

# --- Server ------------------------------------------------------------------
# Port the unified app (UI + API) listens on. The Docker image also honors this.
PORT=8000

# --- AI provider (backend/app/ai/engine.py) ----------------------------------
# "true" (default) = offline mock provider, no keys needed. Safe demo mode.
USE_MOCK_AI=true
# When USE_MOCK_AI=false, choose: openai (default) | anthropic
AI_PROVIDER=openai
# Keys are ONLY needed when USE_MOCK_AI=false. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Frontend data source ----------------------------------------------------
# "true" = frontend uses bundled demo data (no backend needed). Default for
# packaged builds (EXE). For web/development against a live backend use false.
NEXT_PUBLIC_USE_MOCK=true

# --- Web / development -------------------------------------------------------
# Backend URL the frontend talks to when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:8000
